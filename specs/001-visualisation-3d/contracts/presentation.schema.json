{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elec-garage.local/contracts/presentation.schema.json",
  "title": "Présentation de la maquette",
  "description": "Couleurs, opacités, éclairage, réglages de caméra, vues prédéfinies et libellés d'affichage. Rien de tout cela ne figure dans le code : régler la maquette ne demande pas d'y toucher.",
  "type": "object",
  "required": [
    "couleurs",
    "paletteCircuits",
    "epaisseurDalle",
    "opacites",
    "eclairage",
    "camera",
    "vues",
    "vueInitiale",
    "libelles",
    "toleranceRaccordement",
    "diametreConduitConventionnel"
  ],
  "additionalProperties": false,
  "properties": {
    "couleurs": {
      "type": "object",
      "required": [
        "fond",
        "paroi",
        "faceInterieure",
        "sol",
        "plafond",
        "arete",
        "obstacle",
        "obstacleIncertain",
        "composantEnPlace",
        "composantSansCircuit",
        "contourAjout"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/couleur"
      }
    },
    "paletteCircuits": {
      "description": "Repli déterministe quand un apport ne déclare pas de couleur de circuit (FR-008).",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/couleur"
      }
    },
    "epaisseurDalle": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Épaisseur de représentation du sol et du plafond, en mètres."
    },
    "toleranceRaccordement": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Distance en mètres sous laquelle deux extrémités sont tenues pour raccordées. Les tracés sont saisis à la main au centimètre : exiger l'égalité exacte des coordonnées ferait échouer le contrôle de continuité sur des arrondis sans réalité physique. Valeur explicite et modifiable, pas une constante cachée."
    },
    "diametreConduitConventionnel": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Diamètre de tracé, en mètres, employé pour DESSINER un conduit dont le diamètre réel n'est pas encore arrêté. C'est une convention de dessin : la fiche du cheminement DOIT alors afficher le diamètre comme inconnu. Le dessin est conventionnel, la donnée reste déclarée absente."
    },
    "opacites": {
      "type": "object",
      "required": [
        "arete",
        "obstacle",
        "obstacleIncertain"
      ],
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "eclairage": {
      "type": "object",
      "required": [
        "hemispherique",
        "directionnel"
      ],
      "additionalProperties": false,
      "properties": {
        "hemispherique": {
          "type": "object",
          "required": [
            "ciel",
            "sol",
            "intensite"
          ],
          "additionalProperties": false,
          "properties": {
            "ciel": {
              "$ref": "#/$defs/couleur"
            },
            "sol": {
              "$ref": "#/$defs/couleur"
            },
            "intensite": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "directionnel": {
          "type": "object",
          "required": [
            "couleur",
            "intensite",
            "position"
          ],
          "additionalProperties": false,
          "properties": {
            "couleur": {
              "$ref": "#/$defs/couleur"
            },
            "intensite": {
              "type": "number",
              "minimum": 0
            },
            "position": {
              "type": "object",
              "required": [
                "x",
                "y",
                "z"
              ],
              "additionalProperties": false,
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "camera": {
      "type": "object",
      "required": [
        "champ",
        "proche",
        "lointain",
        "rayonMin",
        "rayonMax"
      ],
      "additionalProperties": false,
      "properties": {
        "champ": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "proche": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "lointain": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rayonMin": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rayonMax": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "vues": {
      "description": "Vues prédéfinies en coordonnées sphériques autour du centre du local, pour atteindre plafond, sol et angles sans zone aveugle (FR-004).",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "libelle",
          "theta",
          "phi",
          "rayon"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "libelle": {
            "type": "string",
            "minLength": 1
          },
          "theta": {
            "type": "number",
            "description": "Azimut en radians."
          },
          "phi": {
            "type": "number",
            "description": "Inclinaison en radians, de 0 (zénith) à π (nadir)."
          },
          "rayon": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "vueInitiale": {
      "type": "string",
      "description": "Identifiant d'une vue déclarée ci-dessus."
    },
    "libelles": {
      "type": "object",
      "required": [
        "parois",
        "faces"
      ],
      "additionalProperties": false,
      "properties": {
        "parois": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "faces": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "couleur": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    }
  }
}
